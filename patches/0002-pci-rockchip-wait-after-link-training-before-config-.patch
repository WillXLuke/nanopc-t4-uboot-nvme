From e6cbb583afb94b64fe56164f546523dc57d7fcec Mon Sep 17 00:00:00 2001
From: dsh <dsh@localhost>
Date: Sat, 17 Oct 2026 23:43:39 +0800
Subject: [PATCH 2/5] pci: rockchip: wait after link training before config
 access

Some NVMe SSDs (and other endpoints) answer the first config-space read
with a synchronous abort if it happens immediately after the link comes
up.  Add a 100 ms settle delay before the root complex registers and the
address translation windows are used, so the following PCI scan sees the
device reliably.
---
 drivers/pci/pcie_rockchip.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/pci/pcie_rockchip.c b/drivers/pci/pcie_rockchip.c
index 19f9e58a..e1529bc5 100644
--- a/drivers/pci/pcie_rockchip.c
+++ b/drivers/pci/pcie_rockchip.c
@@ -340,6 +340,14 @@ static int rockchip_pcie_init_port(struct udevice *dev)
 		goto err_power_off_phy;
 	}
 
+	/*
+	 * Give the link and the endpoint a moment to settle before the first
+	 * config-space access.  Several NVMe SSDs otherwise answer the first
+	 * config read with a synchronous abort, which makes the device
+	 * disappear from the PCI scan (seen on RK3399 with various cards).
+	 */
+	mdelay(100);
+
 	/* Initialize Root Complex registers. */
 	writel(PCIE_LM_VENDOR_ROCKCHIP, priv->apb_base + PCIE_LM_VENDOR_ID);
 	writel(PCI_CLASS_BRIDGE_PCI_NORMAL << 8,
