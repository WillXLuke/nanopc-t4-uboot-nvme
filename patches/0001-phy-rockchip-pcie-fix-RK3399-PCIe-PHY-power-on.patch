From 353a7fb398815118eb78a45ec98a9b2088989d6c Mon Sep 17 00:00:00 2001
From: dsh <dsh@localhost>
Date: Sat, 17 Oct 2026 23:43:39 +0800
Subject: [PATCH 1/5] phy: rockchip-pcie: fix RK3399 PCIe PHY power-on

Three problems kept the RK3399 PCIe PHY PLL from locking:

 - readl_poll_sleep_timeout() takes (sleep_us, timeout_us), but all
   three PLL polls passed (20 * 1000, 50), i.e. a 20 ms sleep and a
   50 us timeout.  The loop therefore gave up after one 20 ms sleep
   instead of polling for the intended 100 ms.  Use (200, 100 * 1000),
   matching the current Linux driver.

 - SCLK_PCIEPHY_REF must be muxed to SCLK_PCIEPHY_REF100M and run at
   100 MHz; the PHY PLL is hard-coded for a 100 MHz reference.  The
   clock driver only flipped the mux bit and never configured the
   source, so the PHY still had no valid reference clock even though
   clk_get_rate() reported 100 MHz.  Program NPLL to 800 MHz and the
   /8 divider in rk3399_pciephy_set_clk(), and force the rate from the
   PHY probe with clk_set_rate().

 - Log the actual refclk rate in the PLL timeout message so a failure
   of the clock path is immediately visible.

Also apply the assigned-clock-* properties (best effort) before forcing
the rate.
---
 drivers/clk/rockchip/clk_rk3399.c        | 21 ++++++++++++--
 drivers/phy/rockchip/phy-rockchip-pcie.c | 37 +++++++++++++++++++-----
 2 files changed, 48 insertions(+), 10 deletions(-)

diff --git a/drivers/clk/rockchip/clk_rk3399.c b/drivers/clk/rockchip/clk_rk3399.c
index 6e87db18..5957623a 100644
--- a/drivers/clk/rockchip/clk_rk3399.c
+++ b/drivers/clk/rockchip/clk_rk3399.c
@@ -55,6 +55,12 @@ struct pll_div {
 
 static const struct pll_div gpll_init_cfg = PLL_DIVISORS(GPLL_HZ, 2, 2, 1);
 static const struct pll_div cpll_init_cfg = PLL_DIVISORS(CPLL_HZ, 1, 2, 2);
+/*
+ * SCLK_PCIEPHY_REF100M = NPLL / 8.  800 MHz / 8 = 100 MHz, the reference
+ * the RK3399 PCIe PHY PLL is hard-wired for.
+ */
+static const struct pll_div npll_800m_cfg __maybe_unused =
+	PLL_DIVISORS(800 * MHz, 1, 3, 1);
 #if !defined(CONFIG_XPL_BUILD)
 static const struct pll_div ppll_init_cfg = PLL_DIVISORS(PPLL_HZ, 2, 2, 1);
 #endif
@@ -935,12 +941,21 @@ static ulong rk3399_pciephy_get_clk(struct rockchip_cru *cru)
 
 static ulong rk3399_pciephy_set_clk(struct rockchip_cru *cru, uint hz)
 {
-	if (hz == 100 * MHz)
+	if (hz == 100 * MHz) {
+		/*
+		 * SCLK_PCIEPHY_REF100M is NPLL / 8, but U-Boot does not
+		 * model that clock tree.  Program NPLL and the divider here;
+		 * flipping only the mux (BIT(10)) leaves the PHY without a
+		 * real 100 MHz clock and its PLL never locks.
+		 */
+		rkclk_set_pll(&cru->npll_con[0], &npll_800m_cfg);
+		rk_clrsetreg(&cru->clksel_con[18], 0x1f << 11, 7 << 11);
 		rk_setreg(&cru->clksel_con[18], BIT(10));
-	else if (hz == OSC_HZ)
+	} else if (hz == OSC_HZ) {
 		rk_clrreg(&cru->clksel_con[18], BIT(10));
-	else
+	} else {
 		return -EINVAL;
+	}
 
 	return rk3399_pciephy_get_clk(cru);
 }
diff --git a/drivers/phy/rockchip/phy-rockchip-pcie.c b/drivers/phy/rockchip/phy-rockchip-pcie.c
index 5775101c..9d1835b9 100644
--- a/drivers/phy/rockchip/phy-rockchip-pcie.c
+++ b/drivers/phy/rockchip/phy-rockchip-pcie.c
@@ -113,10 +113,11 @@ static int rockchip_pcie_phy_power_on(struct phy *phy)
 	ret = readl_poll_sleep_timeout(priv->reg_base + priv->data->pcie_status,
 				       status,
 				       status & PHY_PLL_LOCKED,
-				       20 * 1000,
-				       50);
+				       200,
+				       100 * 1000);
 	if (ret) {
-		dev_err(phy->dev, "pll lock timeout!\n");
+		dev_err(phy->dev, "pll lock timeout (refclk %lu Hz)!\n",
+			clk_get_rate(&priv->refclk));
 		goto err_pll_lock;
 	}
 
@@ -127,8 +128,8 @@ static int rockchip_pcie_phy_power_on(struct phy *phy)
 	ret = readl_poll_sleep_timeout(priv->reg_base + priv->data->pcie_status,
 				       status,
 				       !(status & PHY_PLL_OUTPUT),
-				       20 * 1000,
-				       50);
+				       200,
+				       100 * 1000);
 	if (ret) {
 		dev_err(phy->dev, "pll output enable timeout!\n");
 		goto err_pll_lock;
@@ -143,8 +144,8 @@ static int rockchip_pcie_phy_power_on(struct phy *phy)
 	ret = readl_poll_sleep_timeout(priv->reg_base + priv->data->pcie_status,
 				       status,
 				       status & PHY_PLL_LOCKED,
-				       20 * 1000,
-				       50);
+				       200,
+				       100 * 1000);
 	if (ret) {
 		dev_err(phy->dev, "pll relock timeout!\n");
 		goto err_pll_lock;
@@ -220,6 +221,7 @@ static struct phy_ops rockchip_pcie_phy_ops = {
 static int rockchip_pcie_phy_probe(struct udevice *dev)
 {
 	struct rockchip_pcie_phy *priv = dev_get_priv(dev);
+	ulong rate;
 	int ret;
 
 	priv->data = (const struct rockchip_pcie_phy_data *)
@@ -229,12 +231,33 @@ static int rockchip_pcie_phy_probe(struct udevice *dev)
 
 	priv->reg_base = syscon_get_first_range(ROCKCHIP_SYSCON_GRF);
 
+	/*
+	 * SCLK_PCIEPHY_REF must be sourced from SCLK_PCIEPHY_REF100M and run
+	 * at 100 MHz: the PHY PLL is hard-coded for a 100 MHz reference, and
+	 * the clock driver only un-gates the 100 MHz branch when
+	 * clksel_con[18].bit10 is set.  Apply assigned-clock-* first (best
+	 * effort), then force the rate directly; relying on the assigned
+	 * clocks alone leaves the PHY without a reference clock and makes
+	 * power_on() time out waiting for the PLL lock.
+	 */
+	ret = clk_set_defaults(dev, CLK_DEFAULTS_PRE);
+	if (ret)
+		dev_warn(dev, "assigned-clock defaults failed (%d)\n", ret);
+
 	ret = clk_get_by_name(dev, "refclk", &priv->refclk);
 	if (ret) {
 		dev_err(dev, "failed to get refclk clock phandle\n");
 		return ret;
 	}
 
+	rate = clk_set_rate(&priv->refclk, 100000000);
+	if (IS_ERR_VALUE(rate)) {
+		dev_err(dev, "failed to set refclk to 100 MHz (err=%ld)\n",
+			(long)rate);
+		return -EINVAL;
+	}
+	dev_info(dev, "refclk rate %lu Hz\n", clk_get_rate(&priv->refclk));
+
 	ret = reset_get_by_name(dev, "phy", &priv->phy_rst);
 	if (ret) {
 		dev_err(dev, "failed to get phy reset phandle\n");
-- 
